# Blood Bank Management System - Environment Configuration
# Copy this file to .env and configure with your MySQL credentials

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=blood_bank_db

SECRET_KEY=your_super_secret_session_key_here
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Minimum stock threshold for low-stock warning banners
LOW_STOCK_THRESHOLD=5
